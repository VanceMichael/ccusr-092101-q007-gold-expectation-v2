{
  "scenario": "美联储决议夜：五类素材在禁发、渠道与署名约束下的可用性判断（示例编号不含真实身份）",
  "requests": [
    {
      "POST /sources": {
        "source_id": "src-term-demo",
        "name": "行情终端（示例）",
        "kind": "terminal"
      }
    },
    {
      "POST /sources/src-term-demo/contracts": {
        "version_label": "2026Q3-v1",
